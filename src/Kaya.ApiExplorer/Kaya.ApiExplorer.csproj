<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Kaya.ApiExplorer</PackageId>
    <PackageVersion>2.4.2</PackageVersion>
    <Authors>RazvanGolan</Authors>
    <Company>RazvanGolan</Company>
    <Product>Kaya API Explorer</Product>
    <Description>An interactive API debugging and exploration tool for .NET applications. Automatically discovers your HTTP endpoints and provides an UI designed specifically for real-time testing and debugging. Features an advanced request builder with cURL import/export, dynamic payload generation, detailed response analysis, and a dedicated SignalR Debug Tool for seamless WebSocket and hub testing.</Description>    <PackageTags>api;explorer;documentation;endpoints;aspnetcore;middleware;ui;interactive;signalr;realtime;websockets;</PackageTags>
    <RepositoryUrl>https://github.com/RazvanGolan/Kaya</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/RazvanGolan/Kaya</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>Version 2.4.2: Fixed a StackOverflowException that crashed the host application during endpoint scanning when a request/response type contained a circular reference through directly nested properties (e.g. JsonObject/JsonNode or self-referencing DTOs). Example generation now tracks visited types and renders circular references as empty objects.</PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="UI/**/*" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="UI/ApiExplorer/icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
